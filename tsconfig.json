{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022","DOM","DOM.Iterable"],
    "rootDir": "src",
    "outDir": "js",
    "strict": true,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
